<UserControl x:Class="ScriptIX.App.Views.ManualView" Foreground="{StaticResource Text}"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <Grid Margin="28,24,28,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <DockPanel Margin="0,0,0,16">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Content="Example" Command="{Binding ExampleCommand}" ToolTip="Fill in a short example that shows every marker"/>
        <Button Content="Import .txt / .sh…" Command="{Binding ImportCommand}"/>
        <Button Content="Save list…" Command="{Binding SaveCommand}"/>
        <Button Content="Clear" Command="{Binding ClearCommand}" Style="{StaticResource Danger}" Margin="0"/>
      </StackPanel>
      <StackPanel>
        <TextBlock Style="{StaticResource H1}" Text="Type your own commands"/>
      </StackPanel>
    </DockPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <!-- editor -->
      <Border Style="{StaticResource CardBorder}" Padding="0" Background="{StaticResource CodeBg}" BorderBrush="#1E293B">
        <DockPanel>
          <Border DockPanel.Dock="Top" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="14,9">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Foreground="#64748B" FontSize="13">
                <Run Text="{Binding LineCount, Mode=OneWay, StringFormat='{}{0:N0} lines'}"/>
              </TextBlock>
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="10" Height="10" Fill="#F87171" Margin="0,0,6,0"/>
                <Ellipse Width="10" Height="10" Fill="#FBBF24" Margin="0,0,6,0"/>
                <Ellipse Width="10" Height="10" Fill="#34D399" Margin="0,0,14,0"/>
                <TextBlock Text="commands.txt" Foreground="#94A3B8" FontFamily="{StaticResource Mono}" FontSize="12"/>
                <Border Background="#1E2B47" CornerRadius="9" Padding="9,1" Margin="12,0,0,0">
                  <TextBlock Text="{Binding CounterText}" Foreground="#A5B4FC" FontSize="12.5" FontWeight="SemiBold"/>
                </Border>
              </StackPanel>
            </DockPanel>
          </Border>
          <Grid>
            <TextBox Text="{Binding CommandsText, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                     AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                     FontFamily="{StaticResource Mono}" FontSize="13.5" Padding="14,10"
                     Background="Transparent" Foreground="{StaticResource CodeText}" BorderThickness="0"
                     CaretBrush="#A5B4FC" SelectionBrush="#4F46E5" VerticalContentAlignment="Top"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     AutomationProperties.Name="Commands, one per line"/>
            <TextBlock IsHitTestVisible="False" Margin="18,12" Foreground="#475569" FontFamily="{StaticResource Mono}" FontSize="13.5"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" LineHeight="22"
                       Text="# A line starting with # names the next command&#x0a;sysctl -n kernel.randomize_va_space ## expect: 2&#x0a;id -un"/>
          </Grid>
        </DockPanel>
      </Border>

      <!-- side panel -->
      <ScrollViewer Grid.Column="2" Width="340" Margin="16,0,0,0" VerticalScrollBarVisibility="Auto" Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVis}}">
        <StackPanel>

          <Border Style="{StaticResource CardBorder}" BorderBrush="#FDE68A" Background="#FFFDF5"
                  Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVis}}">
            <StackPanel>
              <TextBlock Style="{StaticResource H2}" Text="Look at these first" Foreground="{StaticResource Warn}"/>
              <ItemsControl ItemsSource="{Binding Warnings}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="13.5" Margin="0,0,0,6"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,14,0,0" Padding="18,12">
      <DockPanel LastChildFill="False">
        <Button DockPanel.Dock="Right" Style="{StaticResource BigPrimary}"
                Command="{Binding DataContext.CreateFromManualCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                AutomationProperties.Name="Create script from my commands">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Create script"/>
            <TextBlock Text="{Binding CommandCount, StringFormat='  ({0:N0})'}" Opacity="0.85"/>
            <TextBlock Text="  →"/>
          </StackPanel>
        </Button>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
