<UserControl x:Class="ScriptIX.App.Views.RulesView" Foreground="{StaticResource Text}"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ScriptIX.App">
  <UserControl.Resources>
    <c:BindingProxy x:Key="Proxy" Data="{Binding}"/>
  </UserControl.Resources>
  <Grid Margin="28,24,28,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- header -->
    <DockPanel Margin="0,0,0,16">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Content="Load examples" Command="{Binding LoadSamplesCommand}"
                ToolTip="Original example rules for Linux and AIX (safe to try with --dry-run)"/>
        <Button Style="{StaticResource Primary}" Command="{Binding ImportCommand}" Margin="0"
                ToolTip="CIS PDF, SCAP .xml, CSV, JSON, or a .txt/.sh command list (Ctrl+O)">
          <TextBlock Text="Open rules file…"/>
        </Button>
      </StackPanel>
      <StackPanel>
        <TextBlock Style="{StaticResource H1}" Text="Pick the rules"/>
        <TextBlock Style="{StaticResource Sub}" Margin="0,2,0,0">
          <Run Text="{Binding SourceName, Mode=OneWay}" Foreground="{StaticResource Accent}"/>
        </TextBlock>
      </StackPanel>
    </DockPanel>

    <!-- tiles -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14" Visibility="{Binding HasRules, Converter={StaticResource BoolToVis}}">
      <Border Style="{StaticResource Tile}">
        <StackPanel><TextBlock Style="{StaticResource TileNumber}" Text="{Binding TotalCount, StringFormat=N0}"/><TextBlock Style="{StaticResource TileLabel}" Text="RULES"/></StackPanel>
      </Border>
      <Border Style="{StaticResource Tile}" BorderBrush="#BBF7D0">
        <StackPanel><TextBlock Style="{StaticResource TileNumber}" Foreground="{StaticResource Ok}" Text="{Binding ReadyCount, StringFormat=N0}"/><TextBlock Style="{StaticResource TileLabel}" Text="✓ READY"/></StackPanel>
      </Border>
      <Border Style="{StaticResource Tile}" BorderBrush="#FDE68A">
        <StackPanel><TextBlock Style="{StaticResource TileNumber}" Foreground="{StaticResource Warn}" Text="{Binding ReviewCount, StringFormat=N0}"/><TextBlock Style="{StaticResource TileLabel}" Text="! NEEDS REVIEW"/></StackPanel>
      </Border>
      <Border Style="{StaticResource Tile}" BorderBrush="#FECACA">
        <StackPanel><TextBlock Style="{StaticResource TileNumber}" Foreground="{StaticResource Bad}" Text="{Binding RiskyCount, StringFormat=N0}"/><TextBlock Style="{StaticResource TileLabel}" Text="⚠ RISKY"/></StackPanel>
      </Border>
      <Border Style="{StaticResource Tile}" Background="{StaticResource AccentSoft}" BorderBrush="#C7D2FE">
        <StackPanel><TextBlock Style="{StaticResource TileNumber}" Foreground="{StaticResource Accent}" Text="{Binding SelectedCount, StringFormat=N0}"/><TextBlock Style="{StaticResource TileLabel}" Text="TICKED"/></StackPanel>
      </Border>
    </StackPanel>

    <!-- toolbar -->
    <DockPanel Grid.Row="2" Margin="0,0,0,10" Visibility="{Binding HasRules, Converter={StaticResource BoolToVis}}">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="Tick all safe" Command="{Binding SelectSafeCommand}" ToolTip="Tick every Ready rule (in the profile, if one is picked)"/>
        <Button Content="Tick shown" Command="{Binding SelectShownCommand}" ToolTip="Tick the rules in the list below, except risky ones"/>
        <Button Content="Untick all" Command="{Binding SelectNoneCommand}"/>
        <Menu Background="Transparent" VerticalAlignment="Center" Margin="0,0,8,0" Visibility="{Binding HasScap, Converter={StaticResource BoolToVis}}">
          <MenuItem Header="SCAP ▾" Padding="12,7" FontWeight="SemiBold" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="{StaticResource Card}">
            <MenuItem Header="Info" Command="{Binding ScapTools.InfoCommand}" FontWeight="Normal"/>
            <MenuItem Header="Check this content" Command="{Binding ScapTools.CheckContentCommand}" FontWeight="Normal" ToolTip="Finds broken references and duplicate ids"/>
            <Separator/>
            <MenuItem Header="Values…" Command="{Binding ScapTools.ValuesCommand}" FontWeight="Normal" ToolTip="Change the benchmark's values, for example the password length"/>
            <MenuItem Header="Load tailoring…" Command="{Binding ScapTools.LoadTailoringCommand}" FontWeight="Normal"/>
            <MenuItem Header="Save tailoring…" Command="{Binding ScapTools.SaveTailoringCommand}" FontWeight="Normal" ToolTip="Saves the rules marked IN PROFILE and your values as an XCCDF tailoring file"/>
            <Separator/>
            <MenuItem Header="Security guide (.html)…" Command="{Binding ScapTools.GuideCommand}" FontWeight="Normal"/>
            <MenuItem Header="Export fixes" FontWeight="Normal">
              <MenuItem Header="Bash…" Command="{Binding ScapTools.FixCommand}" CommandParameter="bash"/>
              <MenuItem Header="Ansible…" Command="{Binding ScapTools.FixCommand}" CommandParameter="ansible"/>
              <MenuItem Header="Puppet…" Command="{Binding ScapTools.FixCommand}" CommandParameter="puppet"/>
              <MenuItem Header="Kubernetes…" Command="{Binding ScapTools.FixCommand}" CommandParameter="kubernetes"/>
              <MenuItem Header="Ignition…" Command="{Binding ScapTools.FixCommand}" CommandParameter="ignition"/>
              <MenuItem Header="OSBuild blueprint…" Command="{Binding ScapTools.FixCommand}" CommandParameter="blueprint"/>
              <MenuItem Header="Kickstart…" Command="{Binding ScapTools.FixCommand}" CommandParameter="kickstart"/>
              <MenuItem Header="Bootc…" Command="{Binding ScapTools.FixCommand}" CommandParameter="bootc"/>
            </MenuItem>
            <MenuItem Header="Scan with the server's oscap" Command="{Binding ScapTools.OscapCommand}" FontWeight="Normal" ToolTip="Builds a script that runs the oscap that is installed on the server"/>
            <Separator/>
            <MenuItem Header="CVSS score…" Command="{Binding ScapTools.CvssCommand}" FontWeight="Normal"/>
          </MenuItem>
        </Menu>
        <Menu Background="Transparent" VerticalAlignment="Center">
          <MenuItem Header="More ▾" Padding="12,7" FontWeight="SemiBold" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="{StaticResource Card}">
            <MenuItem Header="Add a rule" Command="{Binding AddRuleCommand}" FontWeight="Normal"/>
            <MenuItem Header="Delete the selected rule" Command="{Binding DeleteRuleCommand}" FontWeight="Normal"/>
            <Separator/>
            <MenuItem Header="Save rules as .json…" Command="{Binding SaveRulesCommand}" FontWeight="Normal"/>
            <MenuItem Header="Remove all rules" Command="{Binding ClearCommand}" FontWeight="Normal"/>
          </MenuItem>
        </Menu>
      </StackPanel>
      <StackPanel Orientation="Horizontal">
        <Grid Width="200">
          <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}" Padding="30,6,8,6"
                   AutomationProperties.Name="Search rules"/>
          <TextBlock Text="⌕" Margin="11,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Muted}" IsHitTestVisible="False" FontSize="16"/>
          <TextBlock Text="Search ID, title or fix" Margin="31,0,0,0" VerticalAlignment="Center" Foreground="#94A3B8" IsHitTestVisible="False"
                     Visibility="{Binding SearchText, Converter={StaticResource EmptyToVis}}"/>
        </Grid>
        <ComboBox Width="120" Margin="8,0,0,0" ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}" AutomationProperties.Name="Filter"/>
        <Grid Width="170" Margin="8,0,0,0" Visibility="{Binding HasProfiles, Converter={StaticResource BoolToVis}}">
          <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" AutomationProperties.Name="Profile"
                    ToolTip="Pick a profile: its ready rules get ticked"/>
          <TextBlock Text="Profile" Margin="9,0" VerticalAlignment="Center" Foreground="{StaticResource Muted}" IsHitTestVisible="False">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding SelectedProfile}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>
      </StackPanel>
    </DockPanel>

    <!-- list + details -->
    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="380"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <DataGrid ItemsSource="{Binding VisibleRules}" SelectedItem="{Binding SelectedRule}" IsReadOnly="True"
                Visibility="{Binding HasRules, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="Rules">
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="USE" Width="52" SortMemberPath="Selected">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <CheckBox HorizontalAlignment="Center" IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}"
                          AutomationProperties.Name="{Binding Id, StringFormat='Use rule {0}'}"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="STATUS" Width="136" SortMemberPath="StatusText"
                                  CellTemplate="{StaticResource StatusBadge}"/>
          <DataGridTemplateColumn Header="ID" Width="150" SortMemberPath="Id">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate><TextBlock Text="{Binding Id}" Style="{StaticResource CellMono}" ToolTip="{Binding Id}"/></DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="WHAT IT DOES" Width="*" SortMemberPath="Title">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate><TextBlock Text="{Binding Title}" Style="{StaticResource CellText}" ToolTip="{Binding Title}"/></DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="IN PROFILE" Width="88" SortMemberPath="InProfile"
                                  Visibility="{Binding Data.HasScap, Source={StaticResource Proxy}, Converter={StaticResource BoolToVis}}">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <CheckBox HorizontalAlignment="Center" IsChecked="{Binding InProfile, UpdateSourceTrigger=PropertyChanged}"
                          AutomationProperties.Name="{Binding Id, StringFormat='In profile {0}'}"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="OS" Binding="{Binding Target}" Width="62"/>
          <DataGridTextColumn Header="SEVERITY" Binding="{Binding Severity}" Width="82"/>
        </DataGrid.Columns>
      </DataGrid>

      <!-- empty state -->
      <Border Style="{StaticResource CardBorder}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"
              BorderBrush="#C7D2FE" Padding="40" Grid.ColumnSpan="3">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#F3F4FF" Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">
          <Border Width="64" Height="64" CornerRadius="18" Background="{StaticResource Brand}" HorizontalAlignment="Center">
            <TextBlock Text="⇣" FontSize="30" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="Drop a rules file here" Style="{StaticResource H1}" HorizontalAlignment="Center" Margin="0,18,0,6"/>
          <TextBlock Style="{StaticResource Sub}" TextAlignment="Center" Text="CIS PDF · SCAP .xml · CSV · JSON"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
            <Button Style="{StaticResource Primary}" Content="Open rules file…" Command="{Binding ImportCommand}"/>
            <Button Content="Try the examples" Command="{Binding LoadSamplesCommand}" Margin="0"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- busy overlay -->
      <Border Grid.ColumnSpan="3" Background="#CCF4F6FB" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
        <Border Style="{StaticResource CardBorder}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28,22" MinWidth="360">
          <StackPanel>
            <TextBlock Text="{Binding BusyText}" FontWeight="SemiBold" FontSize="16"/>
            <ProgressBar IsIndeterminate="True" Height="6" Margin="0,14,0,16"/>
            <Button Content="Cancel" Command="{Binding CancelCommand}" HorizontalAlignment="Right" Margin="0"/>
          </StackPanel>
        </Border>
      </Border>

      <GridSplitter Grid.Column="1" Width="14" Background="Transparent" HorizontalAlignment="Center"
                    VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext"
                    Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}"/>

      <!-- details -->
      <Border Grid.Column="2" Width="430" Style="{StaticResource CardBorder}" Padding="0"
              Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,14">
          <StackPanel DataContext="{Binding SelectedRule}">
            <DockPanel>
              <ContentPresenter DockPanel.Dock="Right" Content="{Binding}" ContentTemplate="{StaticResource StatusBadge}"/>
              <TextBlock Text="Rule details" Style="{StaticResource H2}" Margin="0"/>
            </DockPanel>
            <TextBlock Text="{Binding RiskText}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{StaticResource Muted}"/>

            <TextBlock Style="{StaticResource Label}" Text="ID"/>
            <TextBox Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Rule ID"/>
            <TextBlock Style="{StaticResource Label}" Text="WHAT IT DOES"/>
            <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AutomationProperties.Name="Title"/>

            <Grid Margin="0,0,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Style="{StaticResource Label}" Text="OS"/>
                <ComboBox ItemsSource="{Binding DataContext.OsTargets, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding Target}" AutomationProperties.Name="Target OS"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Style="{StaticResource Label}" Text="SEVERITY"/>
                <ComboBox ItemsSource="{Binding DataContext.Severities, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding Severity}" AutomationProperties.Name="Severity"/>
              </StackPanel>
              <StackPanel Grid.Column="4">
                <TextBlock Style="{StaticResource Label}" Text="SHELL"/>
                <ComboBox ItemsSource="{Binding DataContext.Shells, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding Shell}" AutomationProperties.Name="Shell"
                          ToolTip="sh for portable commands; bash for SCAP fixes (skipped where bash is missing)"/>
              </StackPanel>
            </Grid>

            <TextBlock Style="{StaticResource Label}" Text="FIX COMMAND  (what the apply script runs)"/>
            <TextBox Style="{StaticResource CodeBox}" Text="{Binding Remediation, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                     MaxHeight="220" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Fix command"/>
            <TextBlock Text="{Binding ReversibleText}" TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/>

            <TextBlock Style="{StaticResource Label}" Text="CHECK COMMAND  (what the check script runs)"/>
            <TextBox Style="{StaticResource CodeBox}" Text="{Binding Command, UpdateSourceTrigger=PropertyChanged}" MaxHeight="120"
                     VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Check command"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Style="{StaticResource Label}" Text="COMPARE"/>
                <ComboBox ItemsSource="{Binding DataContext.CompareModes, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding Mode}" AutomationProperties.Name="Compare mode"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Style="{StaticResource Label}" Text="EXPECTED"/>
                <TextBox Text="{Binding Expected, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Expected value"/>
              </StackPanel>
            </Grid>

            <TextBlock Style="{StaticResource Label}" Text="UNDO COMMAND  (optional, goes into scriptix_undo_rules.sh)"/>
            <TextBox Style="{StaticResource CodeBox}" Text="{Binding Undo, UpdateSourceTrigger=PropertyChanged, Delay=250}" MaxHeight="120"
                     VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Undo command"/>

            <TextBlock Style="{StaticResource Label}" Text="NOTES"/>
            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True"
                     MaxHeight="160" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" AutomationProperties.Name="Notes"/>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- create bar -->
    <Border Grid.Row="4" Style="{StaticResource CardBorder}" Margin="0,14,0,0" Padding="18,12">
      <DockPanel>
        <Button DockPanel.Dock="Right" Style="{StaticResource BigPrimary}"
                Command="{Binding DataContext.CreateFromRulesCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                AutomationProperties.Name="Create script from the ticked rules">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Create script"/>
            <TextBlock Text="{Binding SelectedCount, StringFormat='  ({0})'}" Opacity="0.85"/>
            <TextBlock Text="  →"/>
          </StackPanel>
        </Button>
        <Button DockPanel.Dock="Right" Content="Check only" Padding="18,10" Margin="0,0,10,0" VerticalAlignment="Center"
                Command="{Binding DataContext.CheckOnlyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                ToolTip="A script that only checks and changes nothing: every rule of the profile, or the ticked rules, or all of them"/>
        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
          <CheckBox Content="Also create a check-only script" IsChecked="{Binding AlsoCreateCheck}" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding ShownText}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="22,0,0,0"
                     Visibility="{Binding HasRules, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- SCAP panels -->
    <Grid Grid.RowSpan="5" Margin="-28,-24,-28,-20" Visibility="{Binding ScapTools.IsOpen, Converter={StaticResource BoolToVis}}">
      <Border Background="#660B1220"/>
      <Border Width="760" Margin="0,24" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{StaticResource Card}" CornerRadius="14" Padding="26,22">
        <DockPanel DataContext="{Binding ScapTools}">
          <TextBlock DockPanel.Dock="Top" Style="{StaticResource H1}" FontSize="20" Text="{Binding PanelTitle}" Margin="0,0,0,14"/>
          <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="Close" Command="{Binding CloseCommand}" Margin="0"
                    Visibility="{Binding ShowValues, Converter={StaticResource NotBoolToVis}}"/>
            <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="Apply" Command="{Binding ApplyValuesCommand}" Margin="0"
                    Visibility="{Binding ShowValues, Converter={StaticResource BoolToVis}}"/>
            <Button DockPanel.Dock="Right" Content="Cancel" Command="{Binding CloseCommand}"
                    Visibility="{Binding ShowValues, Converter={StaticResource BoolToVis}}"/>
            <Button DockPanel.Dock="Left" Style="{StaticResource Ghost}" Content="Reset all" Command="{Binding ResetValuesCommand}"
                    Visibility="{Binding ShowValues, Converter={StaticResource BoolToVis}}"/>
            <Button DockPanel.Dock="Left" Style="{StaticResource Ghost}" Content="Copy" Command="{Binding CopyTextCommand}"
                    Visibility="{Binding ShowText, Converter={StaticResource BoolToVis}}"/>
          </DockPanel>
          <Grid>
            <TextBox Text="{Binding PanelText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" FontSize="13.5"
                     VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Padding="12" AutomationProperties.Name="SCAP text"
                     Visibility="{Binding ShowText, Converter={StaticResource BoolToVis}}"/>
            <StackPanel Visibility="{Binding ShowCvss, Converter={StaticResource BoolToVis}}">
              <TextBlock Style="{StaticResource Label}" Text="VECTOR" Margin="0,0,0,4"/>
              <TextBox Text="{Binding Vector, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="CVSS vector"
                       ToolTip="For example CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H"/>
              <TextBlock Text="{Binding Score}" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,0" MinHeight="70" TextWrapping="Wrap" AutomationProperties.Name="CVSS result"/>
            </StackPanel>
            <DockPanel Visibility="{Binding ShowValues, Converter={StaticResource BoolToVis}}">
              <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                <TextBox Text="{Binding ValueSearch, UpdateSourceTrigger=PropertyChanged, Delay=150}" AutomationProperties.Name="Search values"/>
                <TextBlock Text="Search" Margin="10,0" VerticalAlignment="Center" Foreground="#94A3B8" IsHitTestVisible="False"
                           Visibility="{Binding ValueSearch, Converter={StaticResource EmptyToVis}}"/>
              </Grid>
              <ListBox ItemsSource="{Binding Values}" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.ScrollUnit="Pixel" AutomationProperties.Name="Values">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="Template">
                      <Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter Margin="0,0,10,8"/></ControlTemplate></Setter.Value>
                    </Setter>
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid ToolTip="{Binding Description}">
                      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Title}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Style.Triggers><DataTrigger Binding="{Binding IsChanged}" Value="True"><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="{StaticResource Accent}"/></DataTrigger></Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                      <ComboBox Grid.Column="1" IsEditable="True" IsTextSearchEnabled="False" ItemsSource="{Binding Choices}" VerticalAlignment="Center"
                                Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Title}"/>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </Grid>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
