<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ScriptIX.App</RootNamespace>
    <AssemblyName>ScriptIX</AssemblyName>
    <Version>2.4.1</Version>
    <Product>ScriptIX</Product>
    <Description>Hardening scripts for Linux and AIX</Description>
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=/ScriptIX</PathMap>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ScriptIX.Core\ScriptIX.Core.csproj" />
  </ItemGroup>
</Project>
